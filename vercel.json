{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run vercel-build",
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/cron/gsc",
      "schedule": "17 5 * * *"
    },
    {
      "path": "/api/cron/agents",
      "schedule": "43 3 * * 1"
    },
    {
      "path": "/api/cron/purge",
      "schedule": "29 2 * * *"
    },
    {
      "path": "/api/cron/jobs",
      "schedule": "11 4 * * *"
    }
  ]
}
