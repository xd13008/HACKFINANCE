# Copier en .env.local. En local : valeurs de `npx supabase status -o env`.
# En production : variables du projet Vercel (jamais dans le dépôt).

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Uniquement pour l'import Search Console planifié (jamais pour l'éditorial ni les agents)
SUPABASE_SERVICE_ROLE_KEY=

# --- Portails ---------------------------------------------------------------
# Domaine → portail. En local, *.localhost pointe sur 127.0.0.1.
SITE_DOMAINS=radarfinances.com=daf,www.radarfinances.com=daf,cedermasociete.com=cession,www.cedermasociete.com=cession,radarfinances.localhost=daf,cedermasociete.localhost=cession,radarrh.localhost=rh,radarrse.localhost=rse
# Portails en préparation (status draft, 404 en production) : radarrh.com=rh,radarrse.com=rse
DEFAULT_SITE_KEY=daf
# Autorise l'indexation (robots.txt) — à n'activer qu'en production
ALLOW_INDEXING=false

# --- Mesure d'audience ------------------------------------------------------
# Sel secret du hachage des sessions (32+ caractères aléatoires : openssl rand -hex 24)
ANALYTICS_SALT=

# --- Agents (V2) ------------------------------------------------------------
ANTHROPIC_API_KEY=
# Compte Supabase doté du seul rôle « agent » (local : agent@exemple.test / demo-local-2026)
AGENT_EMAIL=
AGENT_PASSWORD=

# --- Tâches planifiées ------------------------------------------------------
# Vercel Cron envoie « Authorization: Bearer $CRON_SECRET »
CRON_SECRET=

# --- Google Search Console --------------------------------------------------
# JSON complet du compte de service Google (ajouté en lecture sur chaque propriété)
GSC_SERVICE_ACCOUNT=
